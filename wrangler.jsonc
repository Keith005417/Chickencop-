{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chickencop-global-copy",
  "main": "index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "chickencop.com/api/cover-copy",
      "zone_name": "chickencop.com"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COPY_STATE",
        "class_name": "GlobalCopyState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GlobalCopyState"]
    }
  ]
}
